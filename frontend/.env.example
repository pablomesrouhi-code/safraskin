GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_ID/exec
ORDER_NUMBER_PREFIX=nama

# Optional: fallback to backend if GOOGLE_SHEETS_WEBHOOK_URL is empty
API_URL=https://api.safraskin.online
