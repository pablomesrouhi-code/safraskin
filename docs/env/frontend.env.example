# Safra Skin Frontend — Easypanel Environment
# Copy these to your frontend service in Easypanel

# Site URLs
NEXT_PUBLIC_SITE_URL=https://safraskin.online
NEXT_PUBLIC_API_URL=https://api.safraskin.online

# Tracking Pixels (public IDs only — tokens stay on backend)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# WhatsApp support link (display only)
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000

# Optional analytics
NEXT_PUBLIC_GA4_ID=

# Upsell modal countdown (seconds)
NEXT_PUBLIC_UPSELL_TIMER_SECONDS=12
